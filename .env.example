# Production URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered (the CA's Gmail)
QUOTE_TO_EMAIL=csamip53@gmail.com

# Sender address on a domain verified in Resend
QUOTE_FROM_EMAIL="Toka <quotes@yourfirm.com.np>"

# Optional: secret for signing quote-form tokens. If unset, one is derived from RESEND_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# QUOTE_FORM_SECRET=
