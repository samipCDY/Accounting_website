# Site address (canonical links, sitemap, Open Graph).
# Local: http://localhost:3000 — Netlify: your real domain, e.g. https://www.toka.com.np
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered
QUOTE_TO_EMAIL=csamip53@gmail.com

# Sender address.
# Testing: Resend's test sender (only delivers to your Resend account email).
# Live: an address on a domain verified in Resend, e.g. "Toka <quotes@toka.com.np>".
QUOTE_FROM_EMAIL="Toka <onboarding@resend.dev>"

# Optional: secret for signing quote-form tokens. If unset, one is derived from RESEND_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# QUOTE_FORM_SECRET=
